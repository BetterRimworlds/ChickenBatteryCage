<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<WorkGiverDef>
		<defName>CBC_TakeHensToBatteryCage</defName>
		<label>load hens into battery cages</label>
		<giverClass>BetterRimworlds.ChickenBatteryCage.WorkGiver_TakeHensToBatteryCage</giverClass>
		<workType>Handling</workType>
		<verb>load</verb>
		<gerund>loading</gerund>
		<!-- Above TakeRoamingAnimalsToPen (160) and TakeToPen (130) so cages win for hens. -->
		<priorityInType>170</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<prioritizeSustains>true</prioritizeSustains>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>CBC_FeedBatteryCages</defName>
		<label>feed battery cages</label>
		<giverClass>BetterRimworlds.ChickenBatteryCage.WorkGiver_FeedBatteryCages</giverClass>
		<workType>Hauling</workType>
		<verb>feed</verb>
		<gerund>feeding</gerund>
		<!-- Above generic hauling and above filling nutrient-paste hoppers, so a
		     low cage pool is refilled before ordinary stockpile tidying. -->
		<priorityInType>55</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>CBC_UnloadBatteryCages</defName>
		<label>unload battery cages</label>
		<giverClass>BetterRimworlds.ChickenBatteryCage.WorkGiver_UnloadBatteryCages</giverClass>
		<workType>Handling</workType>
		<verb>unload</verb>
		<gerund>unloading</gerund>
		<!-- Above loading so a marked bird is moved out before more are roped in. -->
		<priorityInType>175</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>CBC_CleanBatteryCages</defName>
		<label>clean battery cages</label>
		<giverClass>BetterRimworlds.ChickenBatteryCage.WorkGiver_CleanBatteryCages</giverClass>
		<workType>Handling</workType>
		<verb>clean</verb>
		<gerund>cleaning</gerund>
		<!-- Below loading and unloading so live birds are moved first, but above
		     ordinary animal handling, so a dirty cage is serviced promptly. -->
		<priorityInType>165</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>CBC_SpreadFertilizer</defName>
		<label>spread fertilizer</label>
		<giverClass>BetterRimworlds.ChickenBatteryCage.WorkGiver_SpreadFertilizer</giverClass>
		<workType>Growing</workType>
		<verb>spread</verb>
		<gerund>spreading fertilizer</gerund>
		<!-- Below sowing (50). Automatic work is indoor natural ground only.
		     An outdoor pack is spread only when the player orders it. -->
		<priorityInType>40</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>
</Defs>
