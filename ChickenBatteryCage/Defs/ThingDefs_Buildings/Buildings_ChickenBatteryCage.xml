<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>ChickenBatteryCage</defName>
		<label>battery chicken cage</label>
		<description>A four-tier battery cage for a flock of ten hens in a compact 2×3 footprint. Research unlocks in the medieval era; construct it from wood, steel, or glitterworld metals. Animal handlers lead hens here automatically, ahead of ordinary pens. Must be built under a roof covering every cell of the cage. Feed it with a hopper built against its side, like a nutrient paste dispenser.</description>
		<thingClass>BetterRimworlds.ChickenBatteryCage.Building_ChickenBatteryCage</thingClass>
		<graphicData>
			<texPath>Things/Building/ChickenBatteryCage/ChickenBatteryCage</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(2,3)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/ChickenBatteryCage/ChickenBatteryCage_MenuIcon</uiIconPath>
		<researchPrerequisites>
			<li>ChickenBatteryCage</li>
		</researchPrerequisites>
		<techLevel>Medieval</techLevel>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<pathCost>70</pathCost>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<fillPercent>0.70</fillPercent>
		<!-- Cage mesh occupies the cells but does not fully block shots or sight. -->
		<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<WorkToBuild>2500</WorkToBuild>
			<MaxHitPoints>180</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Mass>50</Mass>
			<Beauty>-2</Beauty>
		</statBases>
		<size>(2,3)</size>
		<designationCategory>Production</designationCategory>
		<uiOrder>2070</uiOrder>
		<!-- Defaults to the wide (long-edge-south) landscape orientation but
		     stays rotatable, so the long edge can be turned to face any
		     approach. Handlers work from any adjacent standable cell. -->
		<defaultPlacingRot>East</defaultPlacingRot>
		<rotatable>true</rotatable>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<tickerType>Rare</tickerType>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<placeWorkers>
			<li>BetterRimworlds.ChickenBatteryCage.PlaceWorker_MustBeRoofed</li>
		</placeWorkers>
		<stuffCategories>
			<li>Woody</li>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<!-- Like the nutrient paste dispenser: lets the vanilla hopper be
			     placed against the cage and routes "filling hopper" haul
			     jobs to any hopper touching it. -->
			<wantsHopperAdjacent>true</wantsHopperAdjacent>
		</building>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<staticSunShadowHeight>0.6</staticSunShadowHeight>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
	</ThingDef>
</Defs>
